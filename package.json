{
  "name": "@jobber/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "cache-clean": "nx reset && npm cache clean --force",
    "build": "npx nx run-many -t build -p auth jobs executor products",
    "test": "npx nx affected -t lint test build",
    "start": "nx run-many -t serve -p auth jobs executor products --parallel 4 --output-style=stream",
    "stop": "fuser -k 3000/tcp 3001/tcp 3002/tcp 3003/tcp 2>/dev/null; echo 'Ports cleared'",
    "migrate-db": "docker exec jobber-postgres-1 psql -U postgres -c \"SELECT 'ok' FROM pg_database WHERE datname='jobber-auth'\" | grep -q ok || docker exec jobber-postgres-1 psql -U postgres -c 'CREATE DATABASE \"jobber-auth\";' && cd apps/auth && npx prisma migrate deploy"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "private": true,
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/microservices": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "axios": "^1.21.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "module-alias": "^2.3.4",
    "nestjs-pino": "^5.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "ts-proto": "^2.11.4"
  },
  "_moduleAliases": {
    "@jobber/grpc": "dist/libs/grpc/main",
    "@jobber/graphql": "dist/libs/graphql/main",
    "@jobber/pulsar": "dist/libs/pulsar/main",
    "@jobber/nestjs": "dist/libs/nestjs/main",
    "@jobber/prisma": "dist/libs/prisma/main"
  },
  "overrides": {
    "@apollo/server": "^5.5.1"
  },
  "devDependencies": {
    "@compodoc/compodoc": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@nx/eslint": "24.0.2",
    "@nx/eslint-plugin": "24.0.2",
    "@nx/jest": "24.0.2",
    "@nx/js": "24.0.2",
    "@nx/nest": "24.0.2",
    "@nx/node": "24.0.2",
    "@nx/web": "24.0.2",
    "@nx/webpack": "24.0.2",
    "@nx/workspace": "24.0.2",
    "@swc-node/register": "~1.12.1",
    "@swc/core": "~1.16.20",
    "@swc/helpers": "0.5.23",
    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.6",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.0.0",
    "grpc-tools": "^1.13.1",
    "husky": "^9.1.7",
    "jest": "^30.0.2",
    "jest-environment-node": "^30.0.2",
    "jest-util": "^30.0.2",
    "lint-staged": "^16.4.0",
    "nx": "24.0.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.7.4",
    "prisma": "^7.1.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.40.0",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1"
  }
}
