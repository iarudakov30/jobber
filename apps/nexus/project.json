{
  "name": "nexus",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/nexus/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "codegen": {
      "command": "graphql-codegen --config codegen.ts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "{projectRoot}/codegen.ts",
        "{projectRoot}/src/features/**/*",
        "{workspaceRoot}/apps/auth/schema.gql",
        "{workspaceRoot}/apps/wallet/schema.gql",
        "{workspaceRoot}/apps/payments/schema.gql",
        "{workspaceRoot}/apps/market/schema.gql"
      ],
      "outputs": ["{projectRoot}/src/gql"],
      "cache": true
    }
  }
}
