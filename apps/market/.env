PORT=3006
DATABASE_URL=postgres://postgres:example@localhost:5432/market
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
AUTH_GRPC_SERVICE_URL=localhost:5000
WALLET_GRPC_SERVICE_URL=localhost:5003
# GenerateCandles, for the BackfillCandles job.
MARKET_GRPC_SERVICE_URL=localhost:5004
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://localhost:5672
# The price simulator. Every replica competes for the leader lock in Redis; only the leader
# ticks. MARKET_SIMULATOR=off keeps a replica out of the election (it still serves quotes).
MARKET_SIMULATOR=on
# Seed of the random walk: the same seed gives the same sequence of steps. Unset: a random seed,
# logged at startup.
# MARKET_SEED=42
# How long a limit order stays open: the delay bucket its order.expire goes through
# (delay.1m, delay.30m or delay.24h). delay.1m shows an expiry by hand.
ORDER_EXPIRY_BUCKET=delay.24h
# Test hook (acceptance test 7, ignored in production): exit after storing a market order and
# before settling it; restart without it and recovery settles the order within ~40 s.
# FAULT_CRASH_BEFORE_SETTLE=1
# Real prices for BTC, ETH, HYPE, ZEC (phase 4.5): the simulator leader connects to the exchanges'
# public market data. Unset or anything but `on`: no connection, the live coins have no price.
MARKET_LIVE_PRICES=on
# Order of preference: per coin, the first healthy one prices it (failback after 30 s healthy).
# Binance first: Coinbase's market data terms are stricter (docs/nexuspay/phase-4.5/02-providers.md).
MARKET_PRICE_PROVIDERS=binance,coinbase
# Endpoints (defaults shown); tests point them at fake exchanges.
# COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com
# COINBASE_REST_URL=https://api.exchange.coinbase.com
# BINANCE_WS_URL=wss://data-stream.binance.vision
# BINANCE_REST_URL=https://data-api.binance.vision
