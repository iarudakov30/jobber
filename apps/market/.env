PORT=3006
DATABASE_URL=postgres://postgres:example@localhost:5432/market
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
AUTH_GRPC_SERVICE_URL=localhost:5000
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://localhost:5672
# The price simulator. Every replica competes for the leader lock in Redis; only the leader
# ticks. MARKET_SIMULATOR=off keeps a replica out of the election (it still serves quotes).
MARKET_SIMULATOR=on
# Seed of the random walk: the same seed gives the same sequence of steps. Unset: a random seed,
# logged at startup.
# MARKET_SEED=42
