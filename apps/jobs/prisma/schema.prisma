datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

model Job {
  id        Int       @default(autoincrement()) @id
  name      String
  size      Int
  completed Int
  status    String
  started   DateTime  @default(now())
  ended     DateTime?
  items     JobItem[]
}

/// One row per acknowledged item, inserted by `JobsService.acknowledge`. The primary key makes a
/// redelivered message's second acknowledgement a no-op instead of counting it twice.
model JobItem {
  jobId   Int
  index   Int
  ackedAt DateTime @default(now())
  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([jobId, index])
}

/// The `outbox` table `@jobber/outbox` reads and writes with raw SQL; keep it matching the
/// contract in `libs/outbox/src/lib/outbox.types.ts`.
model OutboxMessage {
  id          BigInt    @id @default(autoincrement())
  transport   String
  destination String
  key         String?
  payload     Json
  headers     Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  publishedAt DateTime? @map("published_at") @db.Timestamptz

  @@index([publishedAt, id])
  @@map("outbox")
}
