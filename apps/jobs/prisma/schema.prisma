datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client-js"
  output     = "../../../node_modules/@prisma-clients/jobs"
  engineType = "client"
}

model Job {
  id        Int       @default(autoincrement()) @id
  name      String
  size      Int
  completed Int
  status    String
  started   DateTime  @default(now())
  ended     DateTime?
}
