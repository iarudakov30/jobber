datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

model Job {
  id        Int       @default(autoincrement()) @id
  name      String
  size      Int
  completed Int
  status    String
  started   DateTime  @default(now())
  ended     DateTime?
}
