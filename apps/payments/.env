PORT=3005
DATABASE_URL=postgres://postgres:example@localhost:5432/payments
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
AUTH_GRPC_SERVICE_URL=localhost:5000
PULSAR_SERVICE_URL=pulsar://localhost:6650
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://localhost:5672
# Where Stripe Checkout sends the user back (the nexus dev server).
APP_URL=http://localhost:4300
# Delay bucket for the payment.expire command: delay.30m (Stripe's minimum session lifetime);
# delay.1m to watch an unpaid top-up expire after a minute (acceptance test 5).
PAYMENT_EXPIRY_BUCKET=delay.30m
# Secrets (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET) go in apps/payments/.env.local, which is
# gitignored. The app reads it first, so its values win.
