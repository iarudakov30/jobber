{
  "name": "wallet",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/wallet/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "args": ["--node-env=production"],
        "cwd": "apps/wallet"
      },
      "configurations": {
        "development": {
          "args": ["--node-env=development"]
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/wallet/package.json",
        "{workspaceRoot}/dist/apps/wallet/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/wallet/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "wallet:build",
        "runBuildTargetDependencies": false,
        "watch": true,
        "port": 9233
      },
      "configurations": {
        "development": {
          "buildTarget": "wallet:build:development"
        },
        "production": {
          "buildTarget": "wallet:build:production"
        }
      }
    },
    "generate-drizzle": {
      "command": "drizzle-kit generate",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "migrate-drizzle": {
      "command": "drizzle-kit migrate",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["create-db"]
    },
    "create-db": {
      "command": "node ../../scripts/create-db.mjs",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "seed": {
      "command": "node ../../scripts/wallet-seed.mjs",
      "options": {
        "cwd": "{projectRoot}"
      }
    }
  },
  "tags": []
}
